<?xml version="1.0" encoding="utf-8"?>
<!--
  Resource-shrinking keep list (isShrinkResources = true).
  flutter_local_notifications looks the notification icon up by name at
  runtime, so the shrinker must not remove it. Per the package README, keep
  the icon (we use @mipmap/ic_launcher) and drawables.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@mipmap/ic_launcher,@mipmap/ic_launcher_foreground,@mipmap/ic_launcher_background,@drawable/*" />
